# PostgreSQL (use sslmode=verify-full e a CA do provedor em produção)
DATABASE_URL=postgresql://postgres:sua_senha@localhost:5432/avaliatech

# JWT - gere uma chave forte antes de ir para produção
JWT_SECRET=troque-por-uma-chave-forte-com-no-minimo-32-caracteres
JWT_EXPIRES_IN=7d
NODE_ENV=development

# URL da Aplicação (usada em links de e-mail)
APP_URL=http://localhost:3000

# E-mail (SMTP)
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu_email@exemplo.com
SMTP_PASSWORD=sua_senha_smtp
SMTP_FROM="AvaliaTech <noreply@avaliatech.com>"

# Gemini (utilizado somente no servidor; nunca exponha a chave ao navegador)
GEMINI_API_KEY=sua_chave_aqui
GEMINI_MODEL=gemini-3.5-flash-lite

# Destinatário das mensagens do formulário Fale Conosco
CONTACT_EMAIL=seu_email_administrativo@exemplo.com
